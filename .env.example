# Bluper — Environment Variables
#
# Copy this file to `.env` at the repository root and set values for local development.
# Do not commit `.env` or any file containing secrets.
#
# Used by: apps/api (NestJS), apps/web (Next.js), and local Docker services (Phase 01+).

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# API (NestJS — apps/api)
# ---------------------------------------------------------------------------

# HTTP port for the backend API
PORT=3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------

# Connection string for Prisma / PostgreSQL (TASK-106 local defaults)
DATABASE_URL=postgresql://bluper:123@localhost:5433/bluper

# ---------------------------------------------------------------------------
# Cache (Redis)
# ---------------------------------------------------------------------------

# Connection URL for Redis (caching, queues — future phases)
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Authentication (JWT)
# ---------------------------------------------------------------------------

# Secret used to sign JWT access tokens (use a long random value in production)
JWT_SECRET=change-me-use-a-long-random-secret

# Access token lifetime (e.g. 15m, 1h)
JWT_ACCESS_TOKEN_EXPIRES_IN=15m

# Refresh token lifetime (e.g. 7d, 30d)
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Allowed browser origin for CORS (Next.js dev server)
CORS_ORIGIN=http://localhost:3001

# ---------------------------------------------------------------------------
# AI providers (ADR-007 — configure at least one for workflow execution)
# ---------------------------------------------------------------------------

# Primary provider when multiple keys are configured: openai | anthropic | google
AI_DEFAULT_PROVIDER=google

# OpenAI — https://platform.openai.com/
OPENAI_API_KEY=

# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google Gemini — https://ai.google.dev/
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Web (Next.js — apps/web)
# ---------------------------------------------------------------------------

# Dev server port (API uses PORT=3000 above)
WEB_PORT=3001

# Backend API base URL exposed to the browser (must use NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_API_URL=http://localhost:3000
